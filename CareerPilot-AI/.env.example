# CareerPilot AI - Environment Configuration Template
# Copy this file to .env and configure values before starting the application:
# cp .env.example .env

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security (Change this in production!)
SECRET_KEY=careerpilot-super-secret-development-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for local development)
DATABASE_URL=sqlite:///./careerpilot.db

# Demo User Credentials (seeded on initialization)
DEMO_USER_EMAIL=demo@careerpilot.ai
DEMO_USER_PASSWORD=DemoPass123!

# Google Gemini API Key (Optional)
# Leave empty to use CareerPilot AI's built-in explainable local coaching engine.
# Set a valid Gemini API key to activate live generative AI chat responses.
GEMINI_API_KEY=
